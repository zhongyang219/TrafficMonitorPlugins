#include <windows.h>
#include "OptionsResource.h"
IDD_CODEX_OPTIONS DIALOGEX 0, 0, 320, 278
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Codex Usage options"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Refresh interval", IDC_POLL_LABEL, 12, 12, 94, 12
    COMBOBOX IDC_POLL, 112, 9, 196, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Theme", IDC_THEME_LABEL, 12, 36, 94, 12
    COMBOBOX IDC_THEME, 112, 33, 196, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Quota bar", IDC_BAR_LABEL, 12, 60, 94, 12
    COMBOBOX IDC_BAR, 112, 57, 196, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Text style", IDC_TEXT_LABEL, 12, 84, 94, 12
    COMBOBOX IDC_TEXT, 112, 81, 196, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "Show 5-hour quota", IDC_SESSION, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 109, 142, 12
    CONTROL "Show 7-day quota", IDC_WEEKLY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 164, 109, 144, 12
    CONTROL "Show reset cards", IDC_CARDS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 130, 142, 12
    CONTROL "Show time bar", IDC_TIME_BAR, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 164, 130, 144, 12
    LTEXT "Week schedule", IDC_SCHEDULE_LABEL, 12, 154, 94, 12
    COMBOBOX IDC_REST_SCHEDULE, 112, 151, 196, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Morning", IDC_MORNING_LABEL, 12, 178, 94, 12
    EDITTEXT IDC_MORNING_START, 112, 175, 70, 14, ES_CENTER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "to", IDC_MORNING_TO, 187, 178, 14, 12
    EDITTEXT IDC_MORNING_END, 205, 175, 70, 14, ES_CENTER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Afternoon", IDC_AFTERNOON_LABEL, 12, 201, 94, 12
    EDITTEXT IDC_AFTERNOON_START, 112, 198, 70, 14, ES_CENTER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "to", IDC_AFTERNOON_TO, 187, 201, 14, 12
    EDITTEXT IDC_AFTERNOON_END, 205, 198, 70, 14, ES_CENTER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Position and background are managed by TrafficMonitor.", IDC_HINT, 12, 224, 296, 24
    DEFPUSHBUTTON "OK", IDOK, 152, 254, 72, 14
    PUSHBUTTON "Cancel", IDCANCEL, 236, 254, 72, 14
END
